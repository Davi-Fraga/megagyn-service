# Copie para .env.local e preencha. NUNCA versione valores reais.
# Em desenvolvimento local, gere automaticamente com: npm run env:local

# URL pública do Supabase (local: http://127.0.0.1:55421)
NEXT_PUBLIC_SUPABASE_URL=
# Chave anon/publishable (pode ir ao navegador; a autorização real é RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role: SOMENTE servidor/worker. Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação (links de recuperação de acesso)
APP_URL=http://localhost:3000
# Fuso de negócio (fronteiras de mês dos fechamentos)
APP_TIMEZONE=America/Sao_Paulo

# Renderizador de PDF: playwright (Chromium local) | gotenberg
PDF_RENDERER=playwright
# Somente se PDF_RENDERER=gotenberg (ex.: https://<servico>.onrender.com)
GOTENBERG_URL=

# Segredo da rota /api/jobs/reports (cron da Vercel envia "Authorization: Bearer <valor>").
# Gere com: openssl rand -hex 32  (mínimo 16 caracteres; sem ele a rota recusa tudo)
CRON_SECRET=

# Banco para scripts de backup (pg_dump). Local: postgresql://postgres:postgres@127.0.0.1:55422/postgres
DATABASE_URL=
